#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
/*行0*/  &kp Y  &kp U  &kp I  &kp O  &kp P
/*行1*/  &kp H  &kp J  &kp K  &kp L  &kp SEMICOLON
/*行2*/  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH
            >;
        };
    };
};
